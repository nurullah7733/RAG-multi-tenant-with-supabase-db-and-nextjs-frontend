# Next.js public environment variables (safe for the browser bundle).
# Copy to .env.local and adjust per environment.

# Base URL of the FastAPI backend consumed by the frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project origin and public publishable key (legacy anon key also supported).
# Never use a service-role key or sb_secret_* key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical frontend origin, used for trusted authentication redirects.
APP_URL=http://localhost:3000
